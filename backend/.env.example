# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Meta Developer App Settings (From Meta App Dashboard -> Basic Settings)
INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here

# Instagram Direct Access Token (For Testing / Development with Instagram Tester accounts)
# Leave empty if using the full OAuth Login flow
INSTAGRAM_ACCESS_TOKEN=your_generated_instagram_tester_access_token_here

# OAuth Redirect URI (Must match Meta App Dashboard -> Instagram -> Valid OAuth Redirect URIs)
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/callback

# Webhook Verification Token (Any secret string you define in Meta Webhook configuration)
INSTAGRAM_VERIFY_TOKEN=creatorconnect_verify_token_secure_2026

# Meta Graph API Base URL
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com/v22.0
